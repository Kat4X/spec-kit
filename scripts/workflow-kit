#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
kit_root="$(cd -- "$script_dir/.." && pwd)"

if [[ -n "${WORKFLOW_KIT_BIN:-}" ]]; then
  exec "$WORKFLOW_KIT_BIN" "$@"
fi

for candidate in "$kit_root/target/release/workflow-kit" "$kit_root/target/debug/workflow-kit"; do
  if [[ -x "$candidate" ]] && [[ -z "$(find "$kit_root/Cargo.toml" "$kit_root/Cargo.lock" "$kit_root/src" "$kit_root/.agents/skills/spec-kit/assets" -newer "$candidate" -print -quit 2>/dev/null)" ]]; then
    exec "$candidate" "$@"
  fi
done

export PATH="/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH"
if command -v cargo >/dev/null 2>&1; then
  exec cargo run --quiet --manifest-path "$kit_root/Cargo.toml" --bin workflow-kit -- "$@"
fi

echo "workflow-kit is unavailable; install the binary or Rust, or set WORKFLOW_KIT_BIN" >&2
exit 5
