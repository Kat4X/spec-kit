#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

required=(
  .agents/skills/spec-kit/SKILL.md
  .agents/skills/spec-kit/assets/SPEC-TEMPLATE.md
  .agents/skills/spec-kit/assets/PLAN-TEMPLATE.md
  .agents/skills/spec-kit/assets/TASKS-TEMPLATE.md
  .agents/skills/spec-kit/references/specify.md
  .agents/skills/spec-kit/references/plan.md
  .agents/skills/spec-kit/references/tasks.md
  .agents/skills/spec-kit/references/implement.md
  .agents/skills/spec-kit/references/verify.md
  .agents/skills/spec-kit/references/list.md
  .agents/skills/spec-kit/references/batch-mode.md
  tools/validate_skill.py
  tests/evals/spec-kit.json
)
for path in "${required[@]}"; do
  [[ -f "$path" ]] || { echo "missing required file: $path" >&2; exit 1; }
done

python3 tools/validate_skill.py .agents/skills/spec-kit
python3 -m unittest discover -s tests -p 'test_*.py'
python3 -m json.tool tests/evals/spec-kit.json >/dev/null

echo "OK: Spec Kit repository checks passed."
